{
  "name": "raw-note-editor",
  "private": true,
  "description": "Builds ../editor.js: CodeMirror 6 in place of the note textarea (only visible lines are in the DOM).",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --legal-comments=eof --outfile=../editor.js"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
